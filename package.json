{
  "name": "removarr",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lint:fix": "eslint . --fix && prettier --write --list-different .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@vite-pwa/nuxt": "^1.1.0",
    "better-sqlite3": "^12.5.0",
    "bowser": "^2.13.1",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "nuxt": "^4.5.2",
    "vue-router": "^5.3.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@cssninja/nuxt-toaster": "^0.5.0",
    "@sidebase/nuxt-auth": "^1.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vue/typescript-plugin": "^3.1.8",
    "daisyui": "^5.5.13",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite-plugin-eslint2": "^5.0.3",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vitepress": {
      "vite": "^7.3.6"
    },
    "vue": "3.5.34"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "@parcel/watcher@2.5.6": true,
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.11.1": true,
    "unrs-resolver@1.12.2": true
  }
}
